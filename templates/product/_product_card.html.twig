{# Role>
    fiche d'un produit
<Role #}

<div class="Card">

    <div class="Card_image">
        <img class="Image" src="/images/{{ product.imageName }}">
    </div>
    <div class="Card_info">
        <p class="Card_title">
            {{ product.name() }}
        </p>
        <p class="Card_description">
            {{ product.description() }}
        </p>
        <p class="Card_price">
            {{ product.price|price }}
        </p>
    </div>

</div>