{# Role>
    fiche d'un produit
<Role #}


<ul>
    <li>nom du produit : {{ product.name }}</li>

    {% set description = product.description %}

    {% if description is not empty %}

        <li>description du produit : {{ product.description }}</li>
    {% else %}

    {% endif %}
    <li>quantite du produit : {{ product.quantityInStock }}</li>
    <li>Prix du produit : {{ (product.price|price()) }}</li>
    <li>Ajouté au catalogue le : {{ product.createAt|dateFr() }}</li>
    <li>
        <img src="/build/images/{{ product.imageName }}">
    </li>
    <li>
        {% if products is defined %}
            <a href="{{ path('product_show',{'id':product.id}) }}">Voir la fiche</a>

        {% else %}
            <a href="{{ path('product_show_all') }}">Voir tous les produits</a>
        {% endif %}
    </li>
</ul>