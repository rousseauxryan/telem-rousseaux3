{# Role>
    fiche d'un produit
<Role #}

{% if products is defined %}

    {% set element_start = '<a class="Card_info" href="'~path('product_show',{'id':product.id})~'">' %}
    {% set element_end = '</a>' %}
    {% set class_if_not_only = '' %}
    {% set is_only = false %}

    {% else %}
        {% set element_start = '<div class="Card_info">' %}
        {% set element_end = '</div>' %}
        {% set class_if_not_only = '-only' %}
        {% set is_only = true %}

{% endif %}



<div class="Card {{ class_if_not_only }}">

    <div class="Card_image">
        <img class="Image" src="/images/{{ product.imageName }}">
    </div>

        {{ element_start|raw }}

        <p class="Card_title">
            {{ product.name() }}
        </p>
        <p class="Card_description">
            {{ product.description() }}
        </p>
        <p class="Card_price">
            {{ product.price|price }}
        </p>
    {% if is_only %}
        <div>
            <a class="Button -link -reverse" href="{{ path('manage_product_edit', {'id':product.id}) }}">Actions</a>
        </div>
    {% endif %}

    {{ element_end|raw }}

</div>